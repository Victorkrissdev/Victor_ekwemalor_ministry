# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or share these values.

# Your Gmail address (the account that sends the email)
GMAIL_USER=

# A 16-character Gmail App Password (NOT your normal Gmail password)
# Create one at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Where contact form messages should be delivered
CONTACT_TO_EMAIL=
